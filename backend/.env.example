DATABASE_URL=sqlite:///./careerlens.db
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret
# Keep the API key on the backend only. Leave blank to use the sample UI only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Provider attempts per user per UTC day (including failures); run a single worker.
ANALYSES_PER_DAY=5
GLOBAL_ANALYSES_PER_DAY=20
